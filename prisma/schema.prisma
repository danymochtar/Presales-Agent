// Presales Agent — MVP single-tenant schema.
// Tables prefixed `auth_` are Better Auth conventional tables.
// Multi-tenant migration path: add `tenantId` columns to all business tables;
// Better Auth user.tenantId already in place for that.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Better Auth tables ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Role within the tenant. The first user signing up becomes "superadmin"
  // (presales manager). Subsequent users default to "user" (presales
  // consultant / head of sales). Superadmin gates: /admin/*, manages templates,
  // monitors LLM usage + cost.
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // membership in tenant (single-tenant MVP: all users belong to default tenant)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  sessions      Session[]
  accounts      Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auth_session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

// ---------- Tenant config (the 7 static-data categories) ----------
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String   @default("Malaysia")
  locale    String   @default("en-MY")
  currency  String   @default("USD")
  fxMyrPerUsd Float? @default(4.70)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Catch-all JSON sections — keep schema flexible during MVP
  identity     Json?  // legal entity, address, signatories, brand
  commercial   Json?  // tax_rate_pct, payment_terms, partner_tier, margin, discount_matrix
  standards    Json?  // primary_cloud, regions, iac, naming, tagging, security_baseline
  team         Json?  // raci_default, escalation
  compliance   Json?  // certifications, regulatory_frameworks
  guardrails   Json?  // redaction, must_review, prohibited, auto_approve

  users          User[]
  rateCardItems  RateCardItem[]
  catalogItems   ServiceCatalogItem[]
  templates      Template[]
  knowledge      KnowledgeSample[]
  projects       Project[]
  patterns       LearnedPattern[]
}

model RateCardItem {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       String
  level      String
  dailyRate  Float
  currency   String  @default("USD")
  location   String  @default("MY")

  @@index([tenantId])
}

model ServiceCatalogItem {
  id                  String  @id @default(cuid())
  tenantId            String
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service             String
  defaultEffortDays   Float
  prerequisite        String?
  deliverable         String?
  notes               String?

  @@index([tenantId])
}

model Template {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Deliverable category this template applies to:
  // bom | assessment | proposal | architecture | tco | project_plan | sow |
  // ms_offering | letterhead | other
  type          String
  // Optional filters — null means the template applies regardless.
  cloudProvider String?  // azure | aws | gcp | null
  projectType   String?  // migration | greenfield | modernization | dr | poc | optimization | null
  // Human-readable name + free description. Nullable so existing rows from
  // the pre-Phase-A schema migrate cleanly; UI falls back to originalName
  // when name is null.
  name          String?
  description   String?
  originalName  String?
  mimeType      String?
  // Extracted text content used as few-shot reference when generating
  // matching deliverables. Populated on upload via the document parsers.
  textContent   String?  @db.Text
  // For binary template rendering (Vercel Blob — phased in later).
  blobUrl       String?
  status        String   @default("active") // active | archived
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, type, status])
}

model KnowledgeSample {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliverableType String   // bom | proposal | architecture | assessment | project_plan
  title           String
  content         String?  // markdown extract
  blobUrl         String?  // optional original file
  outcome         String?  // won | lost | pending
  industry        String?
  useAsReference  Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, deliverableType])
}

// ---------- Projects ----------
model Project {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  customer        String
  industry        String?
  customerSegment String?  // BFSI | Gov | MNC | SMB — drives compliance posture
  stage           String   @default("draft")    // draft | won | lost | pending | graduated
  mode            String   @default("production") // production | training
  scopeSummary    String?
  // Clouds to evaluate (e.g. ["azure"], ["azure", "aws"]).
  targetClouds    String[] @default(["azure"])
  // Cloud chosen as the recommendation after assessment.
  primaryCloud    String?
  // { azure: { primary, dr }, aws: { primary, dr }, gcp: { primary, dr } }
  cloudRegions    Json?
  // consumption (PAYG / On-demand) | reserved-1y | reserved-3y | savings-1y | savings-3y
  purchaseModel   String   @default("consumption")
  // BNM RMiT applicability + critical-system answers + consultation status.
  // Shape defined in src/lib/compliance/bnm-rmit.ts (ProjectComplianceJson).
  compliance      Json?
  // MEDDPICC scoring rubric. Shape in src/lib/meddpicc.ts (Meddpicc).
  meddpicc        Json?
  // migration | greenfield | modernization | dr | poc | optimization | unknown
  projectType            String?
  projectTypeConfidence  String?  // high | medium | low
  projectTypeRationale   String?  // 1-2 sentence why
  // Ordered list of deliverable types AI recommends for this engagement
  suggestedDeliverables  String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inputs       ProjectInput[]
  deliverables Deliverable[]
  feedback     TrainingFeedback[]

  @@index([tenantId])
}

model ProjectInput {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            String   // rvtools | azure_migrate | generic_csv | rfp | meeting_notes | requirements | assessment_report | other
  blobUrl         String?
  filename        String?  // original uploaded filename (preserved for audit)
  workloadsJson   Json?    // parsed normalized workload schema (rvtools/azure_migrate)
  textContent     String?  @db.Text // extracted plain text from RFP/DOCX/PDF/notes (capped server-side)
  rawSummary      String?  // human-readable parse summary (e.g. "23 VMs, 144 vCPU, 384 GB RAM" or "PDF, 12 pages")
  createdAt       DateTime @default(now())

  @@index([projectId])
}

model Deliverable {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String   // bom | proposal | architecture | assessment | project_plan
  cloudProvider String?  // azure | aws | gcp | compare | multi (null for cloud-agnostic deliverables)
  version       Int      @default(1)
  status        String   @default("draft")  // draft | reviewed | final
  contentMd     String   @db.Text
  metadata      Json?    // pricing snapshot, fx used, regions, clouds compared, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // MVP 2: per-cloud versions coexist via cloudProvider in the unique key.
  // Postgres treats multiple NULLs as distinct, so legacy rows with
  // cloudProvider=null don't conflict with new rows that set it explicitly.
  @@unique([projectId, type, cloudProvider, version])
  @@index([projectId, type])
}

model TrainingFeedback {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableType   String
  feedback          String   @db.Text
  extractedPatterns Json?
  createdAt         DateTime @default(now())

  @@index([projectId])
}

model LearnedPattern {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliverableType String
  pattern         String   @db.Text
  scope           String   @default("conditional") // universal | conditional
  conditions      Json?
  confidence      String   @default("medium")
  rationale       String?  @db.Text
  sourceProjectId String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([tenantId, deliverableType])
}

// ---------- LLM usage log (superadmin observability) ----------
// Logged after every LLM call (generateText / generateObject / streamText).
// Drives the /admin/usage dashboard: total calls, token spend, per-user +
// per-purpose breakdown. Best-effort — failures don't break user flow.
model LlmCall {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  projectId     String?
  deliverableId String?
  // What this call was for: extract-project | generate-bom | generate-architecture
  // | generate-proposal | generate-assessment | generate-tco | generate-project-plan
  // | extract-workloads | extract-pattern | etc.
  purpose       String
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  durationMs    Int      @default(0)
  succeeded     Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, purpose])
  @@index([tenantId, userId])
}
