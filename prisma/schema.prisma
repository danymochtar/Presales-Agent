// Presales Agent — MVP single-tenant schema.
// Tables prefixed `auth_` are Better Auth conventional tables.
// Multi-tenant migration path: add `tenantId` columns to all business tables;
// Better Auth user.tenantId already in place for that.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Better Auth tables ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Role within the tenant. The first user signing up becomes "superadmin"
  // (presales manager). Subsequent users default to "user" (presales
  // consultant / head of sales). Superadmin gates: /admin/*, manages templates,
  // monitors LLM usage + cost.
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // membership in tenant (single-tenant MVP: all users belong to default tenant)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  sessions      Session[]
  accounts      Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auth_session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

// ---------- Tenant config (the 7 static-data categories) ----------
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String   @default("Malaysia")
  locale    String   @default("en-MY")
  currency  String   @default("USD")
  fxMyrPerUsd Float? @default(4.70)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Catch-all JSON sections — keep schema flexible during MVP
  identity     Json?  // legal entity, address, signatories, brand
  commercial   Json?  // tax_rate_pct, payment_terms, partner_tier, margin, discount_matrix
  standards    Json?  // primary_cloud, regions, iac, naming, tagging, security_baseline
  team         Json?  // raci_default, escalation
  compliance   Json?  // certifications, regulatory_frameworks
  guardrails   Json?  // redaction, must_review, prohibited, auto_approve
  // Fiscal-year definition. Shape (src/lib/fiscal-year.ts):
  //   { startMonth: 1..12, startDay: 1..31, currentLabel: "FY27" }
  // Required before the dashboard renders — first-login setup gate forces it.
  fiscalYear   Json?
  // External-system credentials, keyed by integration name. Shape:
  //   { creatio: { baseUrl, username, password, lastSyncAt }, ... }
  // Stored unencrypted on the JSON column for pilot only — production should
  // wrap with a KMS-backed envelope before going wide. Schema documented in
  // src/lib/integrations/creatio.ts (CreatioCredentials).
  integrations Json?
  // Display + brand overrides. Shape (src/lib/tenant-settings.ts):
  //   { displayName, logoLetter, accentHue, perCloudHue: { azure, aws, gcp, services } }
  branding     Json?
  // Per-key label overrides. Flat namespace keyed by e.g.
  //   "status.committed", "origin.new_target", "phase.listen", "role.solution_architect"
  // Empty / missing key = fall back to the lib default.
  vocabulary   Json?
  // Operational threshold overrides. Shape (src/lib/tenant-settings.ts):
  //   { mcemGreenPct, mcemAmberPct, fileSizeMb, dashboardLookbackDays,
  //     dashboardActiveMax, dashboardNextActionsMax }
  thresholds   Json?

  users          User[]
  rateCardItems  RateCardItem[]
  catalogItems   ServiceCatalogItem[]
  templates      Template[]
  knowledge      KnowledgeSample[]
  engagements    Engagement[]
  patterns       LearnedPattern[]
  trackers       Tracker[]
  personnel      Personnel[]
  businessTargets BusinessTarget[]
}

model RateCardItem {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       String
  level      String
  dailyRate  Float
  currency   String  @default("USD")
  location   String  @default("MY")

  @@index([tenantId])
}

model ServiceCatalogItem {
  id                  String  @id @default(cuid())
  tenantId            String
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service             String
  defaultEffortDays   Float
  prerequisite        String?
  deliverable         String?
  notes               String?

  @@index([tenantId])
}

model Template {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Deliverable category this template applies to:
  // bom | assessment | proposal | architecture | tco | project_plan | sow |
  // ms_offering | letterhead | other
  type          String
  // Optional filters — null means the template applies regardless.
  cloudProvider String?  // azure | aws | gcp | null
  engagementType String? // migration | greenfield | modernization | dr | poc | optimization | null
  // Human-readable name + free description. Nullable so existing rows from
  // the pre-Phase-A schema migrate cleanly; UI falls back to originalName
  // when name is null.
  name          String?
  description   String?
  originalName  String?
  mimeType      String?
  // Extracted text content used as few-shot reference when generating
  // matching deliverables. Populated on upload via the document parsers.
  textContent   String?  @db.Text
  // For binary template rendering (Vercel Blob — phased in later).
  blobUrl       String?
  status        String   @default("active") // active | archived
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, type, status])
}

model KnowledgeSample {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliverableType String   // bom | proposal | architecture | assessment | project_plan
  title           String
  content         String?  // markdown extract
  blobUrl         String?  // optional original file
  outcome         String?  // won | lost | pending
  industry        String?
  useAsReference  Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, deliverableType])
}

// ---------- Engagements ----------
// A presales Engagement is the unit of work BEFORE a deal closes. Once
// `stage` flips to `closed_won` the team will colloquially call it a
// "Project" — but in this schema the entity stays Engagement throughout
// its lifecycle so we don't fork the data model.
model Engagement {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  customer        String
  industry        String?
  customerSegment String?  // BFSI | Gov | MNC | SMB — drives compliance posture
  // Presales funnel — 7-stage:
  // prospecting | qualifying | discovery | proposed | negotiating |
  // closed_won | closed_lost
  stage           String   @default("prospecting")
  mode            String   @default("production") // production | training
  scopeSummary    String?
  // Clouds to evaluate (e.g. ["azure"], ["azure", "aws"]).
  targetClouds    String[] @default(["azure"])
  // Cloud chosen as the recommendation after assessment.
  primaryCloud    String?
  // { azure: { primary, dr }, aws: { primary, dr }, gcp: { primary, dr } }
  cloudRegions    Json?
  // consumption (PAYG / On-demand) | reserved-1y | reserved-3y | savings-1y | savings-3y
  purchaseModel   String   @default("consumption")
  // lift_and_shift | hybrid | modernization — drives PaaS routing in the BOM
  // generator. Non-modernizable workloads stay on IaaS regardless of strategy.
  migrationStrategy String @default("lift_and_shift")
  // Solution area classification from the AI assessor (one of the values in
  // src/lib/inventory/solution-area.ts). Null until the user runs the
  // assessment or picks an override.
  solutionArea      String?
  // BNM RMiT applicability + critical-system answers + consultation status.
  // Shape defined in src/lib/compliance/bnm-rmit.ts (EngagementComplianceJson).
  compliance      Json?
  // MCEM (Microsoft Customer Engagement Methodology) checklist state.
  // Shape in src/lib/mcem.ts (Mcem) — keyed by McemItemKey.
  mcem            Json?
  // migration | greenfield | modernization | dr | poc | optimization | unknown
  engagementType         String?
  engagementTypeConfidence String? // high | medium | low
  engagementTypeRationale  String? // 1-2 sentence why
  // Ordered list of deliverable types AI recommends for this engagement
  suggestedDeliverables  String[] @default([])
  // Landing-zone picker selection. Shape defined in
  // src/lib/landing-zone/picker.ts (EngagementLandingZoneJson):
  // { archetypes: ["infra" | "platform" | "data_ai"],
  //   selectionsByCloud: { [cloud]: string[] /* component names */ },
  //   updatedAt: ISO }
  landingZone     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inputs        EngagementInput[]
  deliverables  Deliverable[]
  feedback      TrainingFeedback[]
  opportunities Opportunity[]

  @@index([tenantId])
}

model EngagementInput {
  id              String   @id @default(cuid())
  engagementId    String
  engagement      Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  kind            String   // rvtools | azure_migrate | generic_csv | rfp | meeting_notes | requirements | assessment_report | other
  blobUrl         String?
  filename        String?  // original uploaded filename (preserved for audit)
  workloadsJson   Json?    // parsed normalized workload schema (rvtools/azure_migrate)
  textContent     String?  @db.Text // extracted plain text from RFP/DOCX/PDF/notes (capped server-side)
  rawSummary      String?  // human-readable parse summary (e.g. "23 VMs, 144 vCPU, 384 GB RAM" or "PDF, 12 pages")
  createdAt       DateTime @default(now())

  @@index([engagementId])
}

model Deliverable {
  id            String   @id @default(cuid())
  engagementId  String
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  type          String   // bom | proposal | architecture | assessment | project_plan
  cloudProvider String?  // azure | aws | gcp | compare | multi (null for cloud-agnostic deliverables)
  version       Int      @default(1)
  status        String   @default("draft")  // draft | reviewed | final
  contentMd     String   @db.Text
  metadata      Json?    // pricing snapshot, fx used, regions, clouds compared, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Per-cloud versions coexist via cloudProvider in the unique key.
  // Postgres treats multiple NULLs as distinct, so legacy rows with
  // cloudProvider=null don't conflict with new rows that set it explicitly.
  @@unique([engagementId, type, cloudProvider, version])
  @@index([engagementId, type])
}

model TrainingFeedback {
  id                String   @id @default(cuid())
  engagementId      String
  engagement        Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  deliverableType   String
  feedback          String   @db.Text
  extractedPatterns Json?
  createdAt         DateTime @default(now())

  @@index([engagementId])
}

model LearnedPattern {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliverableType     String
  pattern             String   @db.Text
  scope               String   @default("conditional") // universal | conditional
  conditions          Json?
  confidence          String   @default("medium")
  rationale           String?  @db.Text
  sourceEngagementId  String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([tenantId, deliverableType])
}

// ---------- LLM usage log (superadmin observability) ----------
// Logged after every LLM call (generateText / generateObject / streamText).
// Drives the /admin/usage dashboard: total calls, token spend, per-user +
// per-purpose breakdown. Best-effort — failures don't break user flow.
model LlmCall {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  engagementId  String?
  deliverableId String?
  // What this call was for: extract-engagement | generate-bom | generate-architecture
  // | generate-proposal | generate-assessment | generate-tco | generate-project-plan
  // | extract-workloads | extract-pattern | etc.
  purpose       String
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  durationMs    Int      @default(0)
  succeeded     Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, purpose])
  @@index([tenantId, userId])
}

// ---------- Pipeline tracker (consolidated multi-source) ----------
// Each Tracker is one upstream source the user maintains (Microsoft biweekly,
// SMB/SMC/ENT-PS segments, sales rep pipes, funding & program tracker, etc.).
// fieldMapping maps canonical fields → source column headers so different
// source layouts converge on a single Opportunity shape.
model Tracker {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  name          String
  // microsoft | smb | smc | ent_ps | sales_rep | funding | creatio | other
  source        String
  fieldMapping  Json
  statusMapping Json?
  // Applied to every opportunity imported from this tracker when the source
  // row doesn't have its own origin column. Lets the user say "this tracker
  // is all FY26 carry-over" once instead of tagging every row.
  // carry_over | new_target | existing_customer | net_new | unknown
  defaultOriginKind String? @default("unknown")
  // What kind of data is in this tracker — drives the "learn from history vs.
  // plan future" framing on the pipeline page + Business dashboard.
  // historical_pipeline | target_pipeline | current_pipe | funding | crm_sync | other
  purpose       String?   @default("current_pipe")
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunities Opportunity[]

  @@index([tenantId])
}

model Opportunity {
  id                String    @id @default(cuid())
  trackerId         String
  tracker           Tracker   @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  externalId        String?
  customer          String
  name              String
  // committed | upside | uncommitted | at_risk | won | lost |
  // funding_pending_consent | funding_expiring | funding_closed_out |
  // needs_follow_up | unknown
  status            String    @default("unknown")
  rawStatus         String?
  // Planning axis. carry_over | new_target | existing_customer | net_new | unknown.
  // Inherits the tracker's defaultOriginKind on import; users override per row.
  originKind        String    @default("unknown")
  valueUsd          Decimal?  @db.Decimal(14, 2)
  valueMyr          Decimal?  @db.Decimal(14, 2)
  closeDate         DateTime?
  ownerName         String?
  vendor            String?
  fundingProgram    String?
  fundingExpiresAt  DateTime?
  notes             String?   @db.Text
  lastTouchedAt     DateTime  @default(now())
  raw               Json
  engagementId      String?
  engagement        Engagement? @relation(fields: [engagementId], references: [id])
  assignments       OpportunityAssignment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([trackerId])
  @@index([status])
  @@index([originKind])
  @@index([closeDate])
}

// ---------- Team + Business targets (business-lead view) ----------
// Personnel = a person on the team. Roles cover the typical multicloud
// presales motion: Solution Architect, Solution Sales, Account Manager,
// Business Lead, Partner Seller, plus a generic "other" escape hatch.
// One person can carry multiple opportunities (via OpportunityAssignment);
// one opportunity can have N people across roles (multiple SAs, multiple
// sales, multiple AMs).
model Personnel {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  // solution_architect | solution_sales | account_manager | business_lead |
  // partner_seller | csm | other
  role         String
  // Optional segment ownership for filtering. SMB | SMC | ENT | PS | all | null
  segment      String?
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  OpportunityAssignment[]
  targetsOwned BusinessTarget[]

  @@index([tenantId, role])
  @@index([tenantId, active])
}

// Join between Opportunity and Personnel — captures who is doing what on
// each deal. `role` distinguishes SA vs Sales vs AM so one person showing
// up twice on the same deal in two roles is allowed.
model OpportunityAssignment {
  id             String      @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personnelId    String
  personnel      Personnel   @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  // solution_architect | solution_sales | account_manager | partner_seller | csm
  role           String
  createdAt      DateTime    @default(now())

  @@unique([opportunityId, personnelId, role])
  @@index([personnelId])
}

// A business target the team is measured against. The same metric can be
// sliced multiple ways — total revenue Y-on-Y, per cloud, per product line,
// per owner, per segment — by creating one BusinessTarget row per slice.
// Adding / deleting a slice = adding / deleting a row, no schema migration
// needed.
model BusinessTarget {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Fiscal year label, must match Tenant.fiscalYear.currentLabel format. "FY27".
  fiscalYear  String
  // Period within the FY. year | q1 | q2 | q3 | q4 | m01..m12
  period      String   @default("year")
  // What's being measured. revenue | cost | gross_margin_pct | deal_count |
  // win_rate_pct | acr | csat | other (free-form via `notes`).
  metric      String   @default("revenue")
  // Scope axis 1 — cloud bucket. azure | aws | gcp | services | cross_cloud | all
  cloud       String   @default("all")
  // Scope axis 2 — free-form product key. "Azure IaaS" | "Data + AI" |
  // "Managed Services" | etc. Null = aggregate across products.
  productKey  String?
  // Scope axis 3 — segment ownership. SMB | SMC | ENT | PS | all | null
  segment     String?
  // Scope axis 4 — owner. Null = team-wide target.
  ownerId     String?
  owner       Personnel? @relation(fields: [ownerId], references: [id])
  // The number. USD for currency metrics, raw number for counts / percentages.
  valueUsd    Decimal? @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, fiscalYear, period])
  @@index([tenantId, cloud])
  @@index([ownerId])
}
