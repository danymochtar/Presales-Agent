# Database (Vercel Postgres / Neon / external Postgres — direct URL)
DATABASE_URL="postgresql://user:pass@host:5432/db"

# Better Auth — generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# On Vercel, leave BETTER_AUTH_URL empty — auto-detected from
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# For local dev, set it:
# BETTER_AUTH_URL="http://localhost:3000"

# Vercel AI Gateway (preferred — single key for any provider/model)
AI_GATEWAY_API_KEY=""
# Optional model override. Format: "<provider>/<model>"
# Default: anthropic/claude-sonnet-4.5
# AI_MODEL="anthropic/claude-sonnet-4.5"
