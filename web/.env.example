# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Better Auth — generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Vercel Blob (for file uploads later — optional in MVP)
BLOB_READ_WRITE_TOKEN=""

# Default tenant FX (override per tenant in DB once configured)
DEFAULT_FX_MYR_PER_USD="4.70"
